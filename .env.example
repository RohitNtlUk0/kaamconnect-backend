# ==========================================
# KAAMCONNECT PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Application Port & Mode
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=kaamconnect_db
DATABASE_SSL=false

# Application JWT Authentication
JWT_SECRET=super_secret_production_signing_key_replace_me_with_random_64_char_secret
JWT_EXPIRES_IN=30d

# Firebase Admin SDK Configuration (Option 1: Path to serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Firebase Admin SDK Configuration (Option 2: Direct Inline Credentials for Docker/Cloud Deployments)
FIREBASE_PROJECT_ID=kaamconnect-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kaamconnect-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Abuse Protection & Rate Limiting (Requests per TTL in ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=5
