# ==========================================
# KAAMCONNECT PRODUCTION ENVIRONMENT CONFIG
# ==========================================

# Application Port & Mode
PORT=3000
NODE_ENV=development
API_PREFIX=api/v1

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=kaamconnect_db
DATABASE_SSL=false

# Application JWT Authentication
# Generate a unique random secret for every deployment; do not use this example file as-is.
JWT_SECRET=
ADMIN_SECRET_KEY=
JWT_EXPIRES_IN=30d

# Firebase Admin SDK Configuration (Option 1: Path to serviceAccountKey.json)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Firebase Admin SDK Configuration (Option 2: Direct Inline Credentials for Docker/Cloud Deployments)
FIREBASE_PROJECT_ID=kaamconnect-app
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@kaamconnect-app.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Abuse Protection & Rate Limiting (Requests per TTL in ms)
THROTTLE_TTL=60000
THROTTLE_LIMIT=5

# Direct WhatsApp OTP (Baileys). Keep session files on a persistent private disk.
WHATSAPP_OTP_ENABLED=false
WHATSAPP_OTP_PROVIDER=baileys
WHATSAPP_SESSION_PATH=./whatsapp_session
WHATSAPP_OTP_HASH_SECRET=
WHATSAPP_OTP_TTL_SECONDS=300

# Optional Meta Cloud API alternative (used only when provider=meta).
META_WHATSAPP_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_GRAPH_API_VERSION=v20.0
